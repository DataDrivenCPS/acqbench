    s223:actuatedByProperty dpr:feed-pump-speed-command ;
    s223:cnx dpr:feed-pump-in,
        dpr:feed-pump-out ;
    s223:connected dpr:b3w2-valve,
        dpr:feed-valve ;
    s223:connectedFrom dpr:feed-valve ;
    s223:connectedThrough dpr:conn-feed-pump-to-b3w2-valve,
        dpr:conn-feed-valve-to-feed-pump ;
    s223:connectedTo dpr:b3w2-valve ;
