dpr:dpr-system a s223:System ;
    s223:hasBoundaryConnectionPoint dpr:ac_valve-in,
        dpr:air_valve-out,
        dpr:backwash-dosing-pump-in,
        dpr:baf-1-air-junction-inlet-cp,
        dpr:baf-1-air-vent-out,
        dpr:baf-2-air-vent-out,
        dpr:baf-3-air-vent-out,
        dpr:baf-4-air-vent-out,
        dpr:chlorine-tank-in,
        dpr:coag-tank-in,
        dpr:gac-1-air-vent-out,
        dpr:gac-2-air-vent-out,
        dpr:gac-3-air-vent-out,
        dpr:gac-4-air-junction-inlet-cp,
        dpr:gac-4-air-vent-out,
        dpr:h2o2-tank-in,
        dpr:influent-ozone-valve-in,
        dpr:potable-effluent-valve-out,
        dpr:sv8_valve-out,
        dpr:waste-out ;
    s223:hasMember dpr:backwash_reverse_osmosis_subsystem,
        dpr:backwash_subsystem,
        dpr:biological_aerated_filter_subsystem,
        dpr:disinfection_subsystem,
        dpr:granular_activated_carbon_subsystem,
        dpr:influent-ozone-valve,
        dpr:ozone_subsystem,
        dpr:pre-filter,
        dpr:pressure-regulator,
        dpr:ultrafiltration_subsystem,
        dpr:waste .

